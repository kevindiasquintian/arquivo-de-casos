rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Qualquer pessoa pode ver.
    // Qualquer pessoa com o link pode editar (o site faz um login anônimo automático).
    match /{col}/{id} {
      allow read: if col in ['series', 'games', 'rooms', 'meta'];
      allow write: if request.auth != null
                   && col in ['series', 'games', 'rooms', 'meta'];
    }
  }
}
